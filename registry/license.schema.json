{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registry license block",
  "description": "The structured `license` block of a registry record (issue #372). It records what a license states and never decides whether the project may list the feed. Every term is true, false, or unknown; there is no default, so an unmeasured term cannot read as a permissive one. Generated from pipeline/src/scorecard_pipeline/license_ledger.py; the parser there also checks real calendar dates and that a date is not in the future.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "attribution_required",
    "redistribution_allowed",
    "share_alike",
    "status"
  ],
  "properties": {
    "id": {
      "enum": [
        "ODbL-1.0",
        "CC-BY-SA-4.0",
        "CC-BY-SA-3.0",
        "CC-BY-SA",
        "CC-BY-4.0",
        "CC-BY-2.1-JP",
        "CC-BY",
        "CC0-1.0",
        "etalab-2.0",
        "NLOD-2.0",
        "DL-DE-BY-2.0",
        "DL-DE-ZERO-2.0",
        "OGL-UK-3.0",
        "OGL-Canada-2.0",
        "ODC-By-1.0",
        "public-domain",
        "proprietary-terms",
        "other",
        "unknown"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "terms_url": {
      "type": "string",
      "pattern": "^https?://[^\\s/]+\\S*$"
    },
    "retrieved_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "attribution_required": {
      "enum": [
        true,
        false,
        "unknown"
      ]
    },
    "attribution": {
      "type": "string",
      "pattern": "\\S"
    },
    "redistribution_allowed": {
      "enum": [
        true,
        false,
        "unknown"
      ]
    },
    "share_alike": {
      "enum": [
        true,
        false,
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "unreviewed",
        "needs_review",
        "reviewed"
      ]
    },
    "reviewed_by": {
      "type": "string",
      "pattern": "\\S"
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewer_note": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "enum": [
              "other",
              "proprietary-terms"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reviewed_by",
          "reviewed_on"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "reviewed_by"
              ]
            },
            {
              "required": [
                "reviewed_on"
              ]
            }
          ]
        }
      }
    }
  ]
}
