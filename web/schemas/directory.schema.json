{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtfsscorecard.org/schemas/directory.schema.json",
  "title": "GTFS Scorecard national directory",
  "description": "Slim per-scorecard directory plus guarded covered-corpus and location summaries. Additive within a major schema_version: tolerate unknown fields.",
  "type": "object",
  "required": [
    "schema_version",
    "summary",
    "agencies"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "agencies",
        "grade_distribution"
      ],
      "properties": {
        "agencies": {
          "type": "integer",
          "minimum": 0
        },
        "feed_records": {
          "type": "integer",
          "minimum": 0
        },
        "scored_feed_records": {
          "type": "integer",
          "minimum": 0
        },
        "comparison_eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "average_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "median_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "grade_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "expiring_soon": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "object",
          "properties": {
            "lapsed": {
              "type": "integer"
            },
            "stale": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "state",
              "agencies"
            ],
            "properties": {
              "state": {
                "type": "string"
              },
              "agencies": {
                "type": "integer"
              },
              "feed_records": {
                "type": "integer",
                "minimum": 0
              },
              "comparison_eligible_count": {
                "type": "integer",
                "minimum": 0
              },
              "average_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "grade_distribution": {
                "type": "object"
              },
              "expired": {
                "type": "integer"
              }
            }
          }
        },
        "countries": {
          "type": "array",
          "description": "Portable country rollups with nested ISO 3166-2 subdivisions. The legacy states array is unchanged.",
          "items": {
            "type": "object",
            "required": [
              "country_code",
              "country_name",
              "agencies",
              "subdivisions"
            ],
            "properties": {
              "country_code": {
                "type": ["string", "null"],
                "pattern": "^[A-Z]{2}$"
              },
              "country_name": {
                "type": "string"
              },
              "agencies": {
                "type": "integer",
                "minimum": 0
              },
              "feed_records": {
                "type": "integer",
                "minimum": 0
              },
              "comparison_eligible_count": {
                "type": "integer",
                "minimum": 0
              },
              "average_score": {
                "type": ["number", "null"]
              },
              "grade_distribution": {
                "type": "object"
              },
              "expired": {
                "type": "integer",
                "minimum": 0
              },
              "subdivisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "subdivision_code",
                    "subdivision_name",
                    "agencies"
                  ],
                  "properties": {
                    "subdivision_code": {
                      "type": ["string", "null"],
                      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
                    },
                    "subdivision_name": {
                      "type": "string"
                    },
                    "agencies": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "feed_records": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "comparison_eligible_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "average_score": {
                      "type": ["number", "null"]
                    },
                    "grade_distribution": {
                      "type": "object"
                    },
                    "expired": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "size_tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "agencies": {
                "type": "integer"
              },
              "feed_records": {
                "type": "integer"
              }
            }
          }
        },
        "comparison": {
          "type": "object",
          "required": [
            "eligible_count",
            "excluded_count",
            "required_rubric_version",
            "required_scoring_profile_id",
            "required_validator_version",
            "required_measured_categories",
            "measured_category_cohorts",
            "exclusion_counts",
            "absolute_rankings_published",
            "individual_percentiles_published",
            "note"
          ],
          "properties": {
            "eligible_count": {"type": "integer", "minimum": 0},
            "excluded_count": {"type": "integer", "minimum": 0},
            "required_rubric_version": {"type": "string"},
            "required_scoring_profile_id": {"type": "string"},
            "required_validator_version": {"type": "string"},
            "required_reader_archive_profile": {"type": "string"},
            "required_measured_categories": {
              "type": "array",
              "items": {
                "enum": ["correctness", "freshness", "completeness", "realtime"]
              },
              "uniqueItems": true
            },
            "measured_category_cohorts": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "absolute_rankings_published": {"const": false},
            "individual_percentiles_published": {"const": false},
            "exclusion_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
            "note": {"type": "string"}
          }
        }
      }
    },
    "agencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "grade",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "subdivision_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
          },
          "subdivision_name": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "F"
            ]
          },
          "score": {
            "type": "number"
          },
          "comparison_eligible": {
            "type": "boolean",
            "description": "Whether this row belongs to the comparison cohort documented in summary.comparison."
          },
          "correctness": {
            "type": ["number", "null"]
          },
          "freshness": {
            "type": ["number", "null"]
          },
          "completeness": {
            "type": ["number", "null"]
          },
          "realtime": {
            "type": ["number", "null"]
          },
          "size_tier": {
            "type": "string"
          },
          "national_percentile": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100,
            "deprecated": true,
            "description": "Deprecated compatibility field. Current payloads publish null; integers remain valid only so historical 1.x documents still conform."
          },
          "peer_percentile": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100,
            "deprecated": true,
            "description": "Deprecated compatibility field. Current payloads publish null; integers remain valid only so historical 1.x documents still conform."
          },
          "expiry_status": {
            "type": "string"
          },
          "days_until_expiry": {
            "type": [
              "integer",
              "null"
            ]
          },
          "mdb_id": {
            "type": "string"
          },
          "ntd_ready": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ready",
              "at_risk",
              "not_ready",
              null
            ],
            "description": "NTD GTFS certification readiness heads-up; null for non-US agencies (see catalog schema)."
          },
          "google_gate": {
            "type": "string",
            "enum": [
              "pass",
              "at_risk",
              "fail"
            ],
            "description": "Google/Apple Maps four-week coverage bar (see catalog schema)."
          },
          "stops": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Boardable stop count from stops.txt."
          },
          "feed_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The static GTFS URL that was scored."
          },
          "feed_sha256": {
            "type": [
              "string",
              "null"
            ],
            "description": "SHA-256 of the exact feed bytes scored."
          },
          "reader_archive_profile": {
            "type": "string",
            "enum": ["raw-v1", "flat-single-root-v1"]
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the feed was fetched and scored (ISO 8601)."
          },
          "snapshot_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "The scorecard's snapshot date (YYYY-MM-DD)."
          },
          "rubric_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Rubric version that produced this grade."
          },
          "scoring_profile_id": {
            "type": ["string", "null"],
            "description": "Stable scoring-profile identifier that produced this grade."
          },
          "scoring_profile_rubric_version": {
            "type": ["string", "null"],
            "description": "Rubric version declared by the scoring profile."
          },
          "validator_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "MobilityData gtfs-validator release used."
          },
          "scorecard_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Canonical scorecard page for this agency."
          },
          "top_fix": {
            "type": [
              "string",
              "null"
            ],
            "description": "The highest-leverage plain-language fix, when any."
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code. Registry configuration determines which well-formed country codes this deployment activates."
          },
          "modes_measured": {
            "type": "boolean",
            "description": "Whether the route-mode contract was measured for this feed."
          },
          "primary_mode": {
            "type": ["string", "null"]
          },
          "modes": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "has_ferry": {
            "type": ["boolean", "null"]
          },
          "ferry_only": {
            "type": ["boolean", "null"]
          }
        }
      }
    }
  }
}
