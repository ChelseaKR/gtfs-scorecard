{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtfsscorecard.org/schemas/global-coverage.schema.json",
  "title": "GTFS Scorecard global coverage readiness gate",
  "description": "Auditable readiness criteria for the bounded European GTFS Schedule beta. Counts are reviewed feed records, not agencies, operators, routes, or all European transit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "license",
    "attribution",
    "license_scope",
    "generated_at",
    "evaluated_at",
    "status",
    "ready",
    "scope",
    "limitations",
    "methodology",
    "cohort",
    "feature_finder",
    "criteria",
    "countries",
    "exceptions",
    "records"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "license": { "const": "CC-BY-4.0" },
    "attribution": { "type": "string", "minLength": 1 },
    "license_scope": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "not_ready"] },
    "ready": { "type": "boolean" },
    "scope": { "$ref": "#/$defs/scope" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "methodology": { "$ref": "#/$defs/methodology" },
    "cohort": { "$ref": "#/$defs/cohort" },
    "feature_finder": { "$ref": "#/$defs/featureFinder" },
    "criteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "countries": {
      "type": "array",
      "items": { "$ref": "#/$defs/country" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/feedRecord" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ready": { "const": true } },
        "required": ["ready"]
      },
      "then": { "properties": { "status": { "const": "ready" } } },
      "else": { "properties": { "status": { "const": "not_ready" } } }
    }
  ],
  "$defs": {
    "europeCountryCode": {
      "enum": [
        "AT",
        "BE",
        "BG",
        "CH",
        "CY",
        "CZ",
        "DE",
        "DK",
        "EE",
        "ES",
        "FI",
        "FR",
        "GB",
        "GR",
        "HR",
        "HU",
        "IE",
        "IS",
        "IT",
        "LI",
        "LT",
        "LU",
        "LV",
        "MT",
        "NL",
        "NO",
        "PL",
        "PT",
        "RO",
        "SE",
        "SI",
        "SK"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "country_codes", "unit", "selection"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "country_codes": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/europeCountryCode" }
        },
        "unit": { "const": "feed_records" },
        "selection": { "type": "string", "minLength": 1 }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness_window_days",
        "freshness_window_inclusive",
        "future_timestamps_are_fresh",
        "translation_measurement",
        "empty_percentage",
        "registry_permission_fields_not_used"
      ],
      "properties": {
        "freshness_window_days": { "type": "integer", "minimum": 0 },
        "freshness_window_inclusive": { "type": "boolean" },
        "future_timestamps_are_fresh": { "type": "boolean" },
        "translation_measurement": { "type": "string", "minLength": 1 },
        "empty_percentage": { "type": "string", "minLength": 1 },
        "registry_permission_fields_not_used": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feed_record_count",
        "country_count",
        "feature_record_count",
        "largest_country"
      ],
      "properties": {
        "feed_record_count": { "type": "integer", "minimum": 0 },
        "country_count": { "type": "integer", "minimum": 0 },
        "feature_record_count": { "type": "integer", "minimum": 0 },
        "largest_country": {
          "oneOf": [
            { "$ref": "#/$defs/country" },
            { "type": "null" }
          ]
        }
      }
    },
    "featureFinder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_feed_record_count",
        "source_row_count",
        "reviewed_europe_feed_record_count",
        "reviewed_europe_feature_record_count",
        "denominator_disclosed"
      ],
      "properties": {
        "source_feed_record_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "source_row_count": { "type": "integer", "minimum": 0 },
        "reviewed_europe_feed_record_count": { "type": "integer", "minimum": 0 },
        "reviewed_europe_feature_record_count": { "type": "integer", "minimum": 0 },
        "denominator_disclosed": { "type": "boolean" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "actual", "threshold", "operator", "unit", "met"],
      "properties": {
        "key": {
          "enum": [
            "reviewed_feed_records",
            "countries",
            "largest_country_share",
            "fresh_scorecards",
            "translations_measured",
            "portable_location",
            "identity_reviewed",
            "feature_denominator_disclosed"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "actual": { "type": ["number", "boolean", "null"] },
        "threshold": { "type": ["number", "boolean"] },
        "operator": { "enum": [">=", "<=", "="] },
        "unit": { "enum": ["feed_records", "countries", "percent", "boolean"] },
        "met": { "type": "boolean" },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 }
      }
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "country_name", "feed_record_count", "share_pct"],
      "properties": {
        "country_code": { "$ref": "#/$defs/europeCountryCode" },
        "country_name": { "type": "string", "minLength": 1 },
        "feed_record_count": { "type": "integer", "minimum": 1 },
        "share_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "count", "feed_record_ids"],
      "properties": {
        "key": {
          "enum": [
            "missing_directory_record",
            "missing_retrieved_at",
            "malformed_retrieved_at",
            "future_retrieved_at",
            "stale_scorecard",
            "missing_feature_record",
            "translations_not_measured",
            "invalid_portable_location",
            "identity_not_reviewed",
            "feature_denominator_not_disclosed"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "feed_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "organization_id",
        "country",
        "subdivision_code",
        "subdivision_name",
        "feed_url",
        "scorecard_url",
        "retrieved_at",
        "fresh",
        "freshness_status",
        "feature_record_present",
        "translations_measured",
        "portable_location_valid",
        "identity_reviewed",
        "reuse_evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "organization_id": { "type": ["string", "null"], "minLength": 1 },
        "country": { "$ref": "#/$defs/europeCountryCode" },
        "subdivision_code": { "type": "string" },
        "subdivision_name": { "type": "string" },
        "feed_url": { "type": "string", "format": "uri" },
        "scorecard_url": { "type": ["string", "null"], "format": "uri" },
        "retrieved_at": {
          "description": "Raw published timestamp. Malformed values remain visible and are identified by freshness_status.",
          "type": ["string", "null"]
        },
        "fresh": { "type": "boolean" },
        "freshness_status": {
          "enum": [
            "fresh",
            "missing_directory_record",
            "missing_retrieved_at",
            "malformed_retrieved_at",
            "future_retrieved_at",
            "stale_scorecard"
          ]
        },
        "feature_record_present": { "type": "boolean" },
        "translations_measured": { "type": "boolean" },
        "portable_location_valid": { "type": "boolean" },
        "identity_reviewed": { "type": "boolean" },
        "reuse_evidence": { "$ref": "#/$defs/reuseEvidence" }
      }
    },
    "reuseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "source_kind",
        "provider_source_url",
        "terms_url",
        "scope",
        "attribution",
        "reviewed_by",
        "reviewed_on",
        "identity_reviewed"
      ],
      "properties": {
        "decision": { "const": "approved" },
        "source_kind": { "enum": ["official_portal", "provider"] },
        "provider_source_url": { "type": "string", "format": "uri" },
        "terms_url": { "type": "string", "format": "uri" },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "gtfs_schedule" }
        },
        "attribution": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_on": { "type": "string", "format": "date" },
        "identity_reviewed": { "type": "boolean" }
      }
    }
  }
}
