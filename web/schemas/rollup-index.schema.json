{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtfsscorecard.org/schemas/rollup-index.schema.json",
  "title": "GTFS Scorecard rollup index",
  "description": "The list of published program rollups with one summary row each, written beside the per-rollup documents as rollups/index.json.",
  "type": "object",
  "required": ["schema_version", "rollups"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "rollups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "agency_count",
          "average_score",
          "needs_attention",
          "expired"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "agency_count": { "type": "integer", "minimum": 0 },
          "average_score": { "type": ["number", "null"] },
          "needs_attention": { "type": "integer", "minimum": 0 },
          "expired": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
