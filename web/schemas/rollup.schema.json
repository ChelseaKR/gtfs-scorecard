{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtfsscorecard.org/schemas/rollup.schema.json",
  "title": "GTFS Scorecard program rollup",
  "description": "One program's cohort view: members needing attention first, common fixes counted only across the guarded comparison cohort, and expiry / shapes-readiness summaries over all members. Additive within a major schema_version: newer fields stay optional so older published documents still conform. Top level is closed (additionalProperties: false) so a new block cannot reach production without a schema update, the same enforcement point as artifact.schema.json.",
  "type": "object",
  "required": [
    "schema_version",
    "rollup",
    "generated_at",
    "agency_count",
    "average_score",
    "grade_distribution",
    "needs_attention",
    "expired",
    "members",
    "common_fixes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "rollup": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "generated_at": {
      "type": "string"
    },
    "agency_count": {
      "type": "integer",
      "minimum": 0
    },
    "average_score": {
      "type": ["number", "null"]
    },
    "grade_distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A": { "type": "integer", "minimum": 0 },
        "B": { "type": "integer", "minimum": 0 },
        "C": { "type": "integer", "minimum": 0 },
        "D": { "type": "integer", "minimum": 0 },
        "F": { "type": "integer", "minimum": 0 }
      }
    },
    "needs_attention": {
      "type": "integer",
      "minimum": 0
    },
    "expired": {
      "type": "object",
      "required": ["lapsed", "stale", "total"],
      "additionalProperties": false,
      "properties": {
        "lapsed": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "shapes_readiness": {
      "type": "object",
      "required": ["ready", "at_risk", "not_ready", "not_measured", "total"],
      "additionalProperties": false,
      "properties": {
        "ready": { "type": "integer", "minimum": 0 },
        "at_risk": { "type": "integer", "minimum": 0 },
        "not_ready": { "type": "integer", "minimum": 0 },
        "not_measured": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "score",
          "grade",
          "snapshot_date",
          "needs_attention",
          "attention_reason",
          "days_until_expiry",
          "expiry_status",
          "top_fix"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "score": { "type": "number" },
          "grade": { "enum": ["A", "B", "C", "D", "F"] },
          "snapshot_date": { "type": "string" },
          "needs_attention": { "type": "boolean" },
          "attention_reason": { "type": ["string", "null"] },
          "days_until_expiry": { "type": ["integer", "null"] },
          "expiry_status": {
            "enum": ["current", "expiring_soon", "lapsed", "stale", "unknown"]
          },
          "top_fix": { "type": ["string", "null"] },
          "top_fix_code": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Finding code for the member's highest-priority fix, used to preserve evidence context when opening its scorecard."
          },
          "shapes_status": {
            "enum": ["ready", "at_risk", "not_ready", null]
          },
          "annual_trips": { "type": ["integer", "null"] }
        }
      }
    },
    "common_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "fix", "agencies"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "fix": { "type": "string" },
          "agencies": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "eligible_count",
        "excluded_count",
        "required_rubric_version",
        "required_scoring_profile_id",
        "required_validator_version",
        "required_measured_categories",
        "measured_category_cohorts",
        "exclusion_counts",
        "absolute_rankings_published",
        "individual_percentiles_published",
        "note"
      ],
      "properties": {
        "eligible_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "required_rubric_version": {"type": "string"},
        "required_scoring_profile_id": {"type": "string"},
        "required_validator_version": {"type": "string"},
        "required_reader_archive_profile": {"type": "string"},
        "required_measured_categories": {
          "type": "array",
          "items": {
            "enum": ["correctness", "freshness", "completeness", "realtime"]
          },
          "uniqueItems": true
        },
        "measured_category_cohorts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "exclusion_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "absolute_rankings_published": {"const": false},
        "individual_percentiles_published": {"const": false},
        "note": {"type": "string"}
      }
    },
    "state_percentile": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "deprecated": true,
      "description": "Deprecated compatibility field. Current payloads publish null; historical 1.x state rollups may contain an integer."
    }
  }
}
